{
  "name": "@khoralabs/relay-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "biome": "biome check .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "bun run --filter '@khoralabs/relay' typecheck && bun run --filter '@khoralabs/relay-server' typecheck",
    "test": "bun test",
    "prepare": "husky",
    "review": "agent-review run --scope staged --include-workstream",
    "build": "bun run scripts/build-packages.ts",
    "verify": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "release:bump": "bun run scripts/bump-versions.ts",
    "release:publish": "bun run scripts/publish-packages.ts",
    "context": "bun run scripts/context.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@khoralabs/agent-review": "0.2.2",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "minimatch": "^10.2.5",
    "parse-gitignore": "^2.0.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/parse-gitignore": "^1.0.2"
  }
}
